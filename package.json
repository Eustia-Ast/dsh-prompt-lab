{
  "name": "dsh-prompt-lab",
  "version": "1.0.0",
  "description": "Per-session system-prompt section editor for DeepSeek Harness with templates, presets, backups, drafts, message appends and tool switches.",
  "license": "MIT",
  "author": "DSH Prompt Lab contributors",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt-engineering",
    "prompt-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eustia-Ast/dsh-prompt-lab.git"
  },
  "homepage": "https://github.com/Eustia-Ast/dsh-prompt-lab#readme",
  "bugs": {
    "url": "https://github.com/Eustia-Ast/dsh-prompt-lab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.2 <0.2.2-rc.6"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "assets",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-all.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:release",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
